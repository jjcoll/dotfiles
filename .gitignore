# Ignore everything
*

# But not these folders and their contents
!aerospace/
!aerospace/**
!tmux/
!tmux/**
!nvim/
!nvim/**
!ghostty/
!ghostty/**
!zsh/
!zsh/**
!claude/
!claude/**

# herdr: config + docs only — logs, sockets and session.json stay local
!herdr/
!herdr/config.toml
!herdr/README.md

# starship prompt config
!starship.toml

# And not the gitignore itself
!.gitignore

# Ignore TPM installed plugins (like node_modules)
tmux/plugins/
# Editor/tool backups
*.bak
